// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model ContactForm {
  id           Int    @id @default(autoincrement())
  name         String
  email        String
  country      String
  phone_number String
}

model Registration {
  id             Int      @id @default(autoincrement())
  author         String
  co_authors     String
  abstract_title String   @db.LongText
  abstract       String   @db.LongText
  institutions   String   @db.LongText
  type           String
  reg_category   String
  topic          String
  email          String
  orcidId        String   @default("")
  invoiceUrl     String?  @db.LongText
  paid           Boolean
  password       String?
  createdAt      DateTime @default(now())
}

model Paper {
  id              Int      @id @default(autoincrement())
  author          String
  email           String
  co_authors      String?  @db.LongText
  organization    String?  @db.LongText
  paper_title     String   @db.LongText
  manuscript_link String   @db.LongText
  license_link    String?  @db.LongText
  status          String   @default("Uploaded. Waiting to start the review process")
  createdAt       DateTime @default(now())

  @@map("papers")
}

model oauthtoken {
  id            String @id @unique
  user_mail     String
  client_id     String
  client_secret String
  refresh_token String
  access_token  String
  grant_token   String
  expiry_time   String
  redirect_url  String
}

model Zohotoken {
  id            Int    @id @default(autoincrement())
  code          String @unique
  access_token  String
  refresh_token String
  scope         String
}

model Zohocontacts {
  id                 Int      @id @default(autoincrement())
  name               String?
  email              String?  @unique
  zohoId             String?
  registrationItemId String?
  invoiceUrl         String?  @db.LongText
  createdAt          DateTime @default(now())
}
